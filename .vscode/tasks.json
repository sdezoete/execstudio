{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run studio server",
      "type": "process",
      "command": "${workspaceFolder}\\scripts\\run-server.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Mock AI server",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "tests\\mock_llm.py",
        "8001"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "mock-llm",
        "pattern": {
          "regexp": "^__never__$"
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^Mock LLM",
          "endsPattern": "^Mock LLM listening"
        }
      }
    },
    {
      "label": "Run tests",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUTF8": "1"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Install libraries offline (from .\\wheels)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\2-install-offline.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Make sample deck (tests\\sample.pptx)",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "tests\\sample_deck.py",
        "tests\\sample.pptx"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Make test certificate",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "scripts\\make-test-cert.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
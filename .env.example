# Dev/testing only — never used on the air-gapped production server.
# Copy this file to ".env" and fill in your key. The studio reads it automatically
# when no other llm_base_url is configured (see studio/config.py), and talks to the
# real OpenAI API instead of localhost. This stands in for the on-prem DeepSeek
# model while developing on a machine that has internet access.

OPENAI_API_KEY=sk-...

# Optional. Defaults to gpt-5.4-mini (cheap, fast, supports JSON mode).
# OPENAI_MODEL=gpt-5.4-mini

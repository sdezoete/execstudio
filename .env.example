# One flag controls which LLM backend is used (see studio/config.py). Copy this file
# to ".env" and keep DEVELOPMENT=True on any dev machine; set it to False only on the
# air-gapped production server, then fill in LLM_API_KEY there. Nothing else to change.
DEVELOPMENT=True

# --- Development only (DEVELOPMENT=True): OpenAI stands in for the on-prem model ---
OPENAI_API_KEY=sk-...
# Optional. Defaults to gpt-5.4-mini (cheap, fast, supports JSON mode).
# OPENAI_MODEL=gpt-5.4-mini

# --- Production only (DEVELOPMENT=False): Central LLM Client / Aramco MaaS ---
# Values per the Central LLM Client Developer Guide (Oct 2026). studio/llm.py speaks
# MaaS's OpenAI-compatible chat-completions API directly -- no central_llm_client
# package needed. LLM_MODEL must exactly match the corporate MaaS model ID.
LLM_BASE_URL=https://maas.aramco.com.sa/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v41-flash
LLM_VERIFY_SSL=false
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_TOP_K=
LLM_REASONING_EFFORT=
LLM_MAX_RETRIES=3
